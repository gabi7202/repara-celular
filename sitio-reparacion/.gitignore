# ── Secretos: NUNCA subir claves al repositorio ──────────────────────────
.env
.env.*
!.env.example
# .env.local SI es secreto y nunca se sube; el único archivo de env que VIAJA
# en el repo es .env.example, con la clave GENÉRICA de arranque (placeholder):
# permite que el build de Vercel funcione sin configurar nada. Luego solo
# reemplaza GROQ_API_KEY en Vercel por tu clave gsk_... real.
*.pem
*.key
.vercel
.vercel-tmp/

# ── Datos locales (leads/eventos reales de pruebas) ──────────────────────
data/*.jsonl
data/backup-*.jsonl

# ── Basura de Node/SO ────────────────────────────────────────────────────
node_modules/
.DS_Store
Thumbs.db
*.log

# ── NO ignorar: son parte del sitio que Vercel debe desplegar ────────────
# (si alguna vez agregas reglas generales como "data/" o "*.json",
#  estas líneas las mantienen visibles en el repositorio/deploy)
!supabase/
!datos/
!sitemap.xml
!robots.txt
