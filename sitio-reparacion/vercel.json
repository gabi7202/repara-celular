{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "installCommand": "echo 'Sin dependencias: nada que instalar'",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/nosotros(.html)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/privacidad(.html)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/terminos(.html)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), interest-cohort=(), microphone=(self)" }
      ]
    }
  ],
  "redirects": [
    { "source": "/mi-celular-se-mojo-que-hacer", "destination": "/blog/mi-celular-se-mojo-que-hacer/", "permanent": true },
    { "source": "/celular-no-enciende-causas-y-soluciones", "destination": "/blog/celular-no-enciende-causas-y-soluciones/", "permanent": true },
    { "source": "/no-carga-puerto-o-bateria", "destination": "/blog/no-carga-puerto-o-bateria/", "permanent": true },
    { "source": "/cuanto-cuesta-cambiar-la-pantalla-de-un-celular-en-tapachula", "destination": "/blog/cuanto-cuesta-cambiar-la-pantalla-de-un-celular-en-tapachula/", "permanent": true },
    { "source": "/samsung-a17-bloqueado-por-empresa-frp-knox-pago", "destination": "/blog/samsung-a17-bloqueado-por-empresa-frp-knox-pago/", "permanent": true },
    { "source": "/samsung-galaxy-a17-pantalla-rota-precio", "destination": "/blog/samsung-galaxy-a17-pantalla-rota-precio/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/servicio", "destination": "/index.html" },
    { "source": "/nosotros", "destination": "/nosotros.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/terminos", "destination": "/terminos.html" },
    { "source": "/boleto", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
