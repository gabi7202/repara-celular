-/* ── 1b. Banner flotante de recolección inmediata · toast NO bloqueante ───────
-   Profesional: no usa overlay ni bloquea el scroll; aparece tras 0.8s, persistente por sesión. */
+/* ── 1b. Banner flotante de recolección inmediata · rectangular, aparece al hacer scroll ──
+   Profesional: arranca OCULTO (no bloquea el inicio). Se activa cuando el usuario baja ~320px.
+   Cierre por tres vías: botón "Cerrar" con texto, ✕ arriba a la derecha y tecla Escape. */
 (function(){
   const banner = document.getElementById('recoleccion');
   if (!banner) return;
+  let visible = false, cerrado = false;
+  try{ cerrado = sessionStorage.getItem('rc_visto') === '1'; }catch(e){}
+  function mostrar(){
+    if (cerrado || visible) return;
+    visible = true;
+    banner.classList.remove('rc-out');
+    banner.classList.add('rc-on');
+  }
   function cerrar(recordar){
+    if (!visible) return;
     if (recordar){ try{ sessionStorage.setItem('rc_visto', '1'); }catch(e){} }
-    banner.style.transition = 'opacity .3s ease, transform .3s ease';
-    banner.style.opacity = '0'; banner.style.transform = 'translateX(-50%) translateY(16px)';
-    setTimeout(() => { banner.style.display = 'none'; }, 320);
+    cerrado = !!recordar || cerrado;
+    visible = false;
+    banner.classList.remove('rc-on');
+    banner.classList.add('rc-out');
   }
-  let visto = false;
-  try{ visto = sessionStorage.getItem('rc_visto') === '1'; }catch(e){}
-  if (visto){ banner.style.display = 'none'; }
-  else { try{ banner.classList.add('rc-intro'); }catch(e){} }
+  if (!cerrado){
+    let ya = false;
+    const onScroll = () => {
+      if (ya) return;
+      const y = window.scrollY || document.documentElement.scrollTop || 0;
+      if (y > 320){ ya = true; mostrar(); window.removeEventListener('scroll', onScroll, {passive:true}); }
+    };
+    window.addEventListener('scroll', onScroll, {passive:true});
+    /* respaldo táctil: si el usuario interactúa con el contenido también se activa */
+    document.addEventListener('touchmove', onScroll, {passive:true});
+  }
+  /* botones de cierre: ✕ (rcNo), "Lo checo / Cerrar" (rcNoTxt) — preventDefault evita que el enlace dispare navegación */
   ['rcNo','rcNoTxt'].forEach(id => {
     const b = document.getElementById(id);
-    if (b) b.addEventListener('click', () => cerrar(true));
+    if (b) b.addEventListener('click', ev => { ev.preventDefault(); ev.stopPropagation(); cerrar(true); });
   });
   document.addEventListener('keydown', e => {
-    if (e.key === 'Escape' && banner.style.display !== 'none') cerrar(true);
+    if (e.key === 'Escape' && visible) cerrar(true);
   });
 })();
 
