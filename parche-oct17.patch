index 0000000..edbed76
--- /dev/null
+++ b/sitio-reparacion/assets/doc-v2.css
@@ -0,0 +1,139 @@
+/* VoltFix — estilos compartidos para blog, páginas legales y 404.
+   Se sirve con caché de 1 año: las páginas internas cargan instantáneo. */
+*,*::before,*::after{box-sizing:border-box}
+*{margin:0}
+:root{
+  --ink:#0B1220;--paper:#fff;--paper-2:#F5F8FD;--txt:#0F172A;--txt-2:#334155;--txt-3:#5B6B85;
+  --acc:#4C5BD4;--acc-ink:#3D4BBE;--acc-soft:#EFF1FB;--warn:#FFB020;--warn-soft:#FFF4DF;
+  --line:#E6EAF0;--r-s:10px;--r-m:16px;--r-l:24px;
+  --ff:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans",sans-serif;
+  --ff-mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
+}
+@media(prefers-color-scheme:dark){:root{
+  --paper:#0B1220;--paper-2:#101B33;--txt:#EAF0FB;--txt-2:#B4C0DA;--txt-3:#8190A8;
+  --acc:#5B58F5;--acc-soft:#171549;--warn-soft:#2A2113;--line:#22304E}}
+html{scroll-behavior:smooth;scroll-padding-top:80px;-webkit-text-size-adjust:100%}
+body{font-family:var(--ff);background:var(--paper);color:var(--txt);line-height:1.7;font-size:clamp(15.5px,2.6vw,16.5px);-webkit-font-smoothing:antialiased;overflow-x:hidden}
+img{max-width:100%;height:auto;display:block}
+a{color:var(--acc-ink);text-decoration-thickness:1px;text-underline-offset:3px}
+a:hover{color:var(--acc)}
+@media(prefers-color-scheme:dark){a{color:var(--acc)}}
+.wrap{max-width:1120px;margin-inline:auto;padding-inline:20px}
+.narrow{max-width:760px}
+
+/* Header simplificado, consistente con la home */
+.hdr{position:sticky;top:0;z-index:40;background:color-mix(in srgb,var(--paper) 90%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
+.hdr .wrap{display:flex;align-items:center;gap:16px;height:62px}
+.logo{display:flex;align-items:center;gap:10px;text-decoration:none;font-weight:900;letter-spacing:-.03em;font-size:1.1rem;color:var(--txt)}
+.logo-mark{width:32px;height:32px;border-radius:9px;background:var(--acc);display:grid;place-items:center;color:#fff}
+@media(prefers-color-scheme:dark){.logo-mark{background:var(--acc);color:#fff}}
+/* Regla global: texto BLANCO sobre fondos oscuros (no aplica a botones/CTAs) */
+.cta :not(.btn),.cta :not(.btn) a{color:#fff!important}
+.ftr :not(.btn):not(a),.ftr a{color:#FFFFFF}
+.ftr a:hover{color:#fff;text-decoration:underline}
+.logo-mark svg{width:18px;height:18px}
+.logo small{display:block;font-size:.58rem;letter-spacing:.16em;color:var(--txt-3);text-transform:uppercase;margin-top:-3px}
+.hdr nav{margin-left:auto;display:flex;gap:6px;align-items:center}
+.hdr nav a{padding:9px 12px;border-radius:999px;text-decoration:none;font-size:.86rem;font-weight:600;color:var(--txt-2)}
+.hdr nav a:hover{background:var(--paper-2);color:var(--txt)}
+.btn{display:inline-flex;align-items:center;gap:9px;padding:13px 20px;border-radius:999px;font-weight:800;font-size:.9rem;text-decoration:none;border:2px solid transparent;cursor:pointer;transition:transform .15s,box-shadow .15s;white-space:normal;overflow-wrap:anywhere;max-width:100%}
+.btn--acc{background:var(--acc);color:#FFFFFF;box-shadow:0 6px 18px rgba(76,91,212,.3)}
+.btn--acc:hover{transform:translateY(-2px);color:#FFFFFF}
+.btn--wa{background:#2B2B2B;color:#FFFFFF;box-shadow:0 6px 16px rgba(0,0,0,.16)}
+.btn--ghost{border-color:var(--line);color:var(--txt)}
+.btn--ghost:hover{border-color:var(--acc)}
+.btn--dark{background:var(--ink);color:#fff}
+@media(max-width:760px){.hdr nav a:not(.btn){display:none}}
+
+/* Migas de pan */
+.crumbs{font-size:.8rem;color:var(--txt-3);padding:16px 0 0}
+.crumbs a{color:var(--txt-3)}
+.crumbs span{margin-inline:7px}
+
+/* Artículo */
+.hero-doc{padding:clamp(26px,5vw,54px) 0 clamp(18px,3vw,30px)}
+.eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:.7rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--acc-ink);background:var(--acc-soft);padding:6px 13px;border-radius:999px;margin-bottom:14px}
+h1{font-size:clamp(1.9rem,5.4vw,3rem);line-height:1.08;letter-spacing:-.025em;font-weight:800;text-wrap:balance}
+h2{font-size:clamp(1.3rem,3.4vw,1.7rem);letter-spacing:-.02em;margin:2em 0 .6em;line-height:1.2}
+h3{font-size:1.1rem;margin:1.6em 0 .5em;letter-spacing:-.01em}
+p{margin-bottom:1.05em;color:var(--txt)}
+ul,ol{margin:0 0 1.1em 1.3em;color:var(--txt)}
+li{margin-bottom:.5em}
+.lead{font-size:1.1rem;color:var(--txt-2)}
+.meta{display:flex;flex-wrap:wrap;gap:14px;align-items:center;font-size:.82rem;color:var(--txt-3);margin-top:16px}
+.meta b{color:var(--txt-2)}
+figure{margin:1.8em 0}
+figure img{border-radius:var(--r-l);border:1px solid var(--line)}
+figcaption{font-size:.8rem;color:var(--txt-3);margin-top:9px}
+table{width:100%;border-collapse:collapse;margin:1.4em 0;font-size:.92rem}
+/* Móvil: tablas anchas con scroll horizontal en lugar de desbordar la pantalla */
+@media(max-width:720px){
+  article table,main table{display:block;overflow-x:auto;-webkit-overflow-scrolling:touch;white-space:normal}
+  article table td,article table th{min-width:110px}
+  .btn{padding:13px 18px}
+  .wrap{padding-inline:16px}
+}
+/* Adaptación móvil general: tipografía fluida, botones táctiles, sin desbordes */
+@media(max-width:640px){
+  h1{font-size:clamp(1.55rem,7vw,2rem)}
+  h2{margin-top:1.6em;font-size:clamp(1.2rem,5vw,1.45rem)}
+  .hero-doc{padding-top:22px}
+  .btn{width:auto;max-width:100%}
+  .btn-row{gap:10px}
+  .cta-mini{flex-direction:column;align-items:stretch}
+  .cta-mini .btn,.cta .btn-row .btn{flex:1 1 auto;justify-content:center}
+  figure{margin:1.4em 0}
+  blockquote{padding:14px 16px}
+  /* Bloques largos (listas/tablas/detalles) sin desbordes horizontales */
+  article li,article p,details summary{overflow-wrap:anywhere}
+  details summary{min-width:0}
+  .cards{grid-template-columns:1fr}
+  .toc{padding:16px 18px}
+  .meta{gap:10px}
+}
+caption{text-align:left;font-size:.84rem;color:var(--txt-2);padding-bottom:10px}
+th,td{padding:11px 13px;border-bottom:1px solid var(--line);text-align:left}
+thead th{background:var(--paper-2);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--txt-3)}
+td.num,th.num{font-family:var(--ff-mono);font-weight:700;white-space:nowrap}
+.callout{border-left:4px solid var(--acc);background:var(--acc-soft);padding:16px 18px;border-radius:0 var(--r-m) var(--r-m) 0;margin:1.6em 0;font-size:.95rem}
+.callout--warn{border-color:var(--warn);background:var(--warn-soft)}
+.callout b{display:block;margin-bottom:4px}
+blockquote{border-left:3px solid var(--line);padding-left:18px;margin:1.5em 0;color:var(--txt-2);font-style:italic}
+.toc{background:var(--paper-2);border:1px solid var(--line);border-radius:var(--r-l);padding:20px 22px;margin:1.6em 0}
+.toc b{display:block;font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:var(--txt-3);margin-bottom:10px}
+.toc ol{margin:0 0 0 1.1em}
+.toc li{margin-bottom:6px;font-size:.93rem}
+.toc a{text-decoration:none}
+.toc a:hover{text-decoration:underline}
+
+/* CTA interna */
+.cta{background:var(--ink);color:#EAF0FB;border-radius:var(--r-l);padding:clamp(22px,4vw,34px);margin:2.4em 0}
+.cta h2{color:#fff;margin:0 0 .4em}
+.cta p{color:#B4C0DA;margin-bottom:1.2em}
+.cta .btn-row{display:flex;gap:10px;flex-wrap:wrap}
+
+/* Tarjetas de blog */
+.cards{display:grid;gap:18px;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));margin:26px 0}
+.card{border:1px solid var(--line);border-radius:var(--r-l);overflow:hidden;background:var(--paper);transition:transform .16s,box-shadow .16s,border-color .16s;display:flex;flex-direction:column}
+.card:hover{transform:translateY(-3px);box-shadow:0 14px 34px rgba(11,15,18,.10);border-color:var(--acc)}
+.card .thumb{aspect-ratio:16/9;background:var(--paper-2);overflow:hidden}
+.card .thumb img{width:100%;height:100%;object-fit:cover}
+.card .body{padding:18px;display:flex;flex-direction:column;gap:8px;flex:1}
+.card h3{margin:0;font-size:1.04rem;line-height:1.3}
+.card h3 a{text-decoration:none;color:var(--txt)}
+.card p{font-size:.9rem;color:var(--txt-2);margin:0;flex:1}
+.card .foot{display:flex;justify-content:space-between;gap:10px;font-size:.75rem;color:var(--txt-3);border-top:1px solid var(--line);padding-top:11px;margin-top:4px}
+.tag{display:inline-block;font-size:.66rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;background:var(--acc-soft);color:var(--acc-ink);padding:4px 9px;border-radius:999px;align-self:flex-start}
+
+/* Footer */
+.ftr{background:var(--ink);color:#B4C0DA;padding:38px 0 26px;margin-top:56px;font-size:.88rem}
+.ftr a{color:#C7D2E8;text-decoration:none}
+.ftr a:hover{color:var(--acc)}
+.ftr .wrap{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
+.ftr b{color:#fff;display:block;margin-bottom:6px}
+.skip{position:absolute;left:-9999px}
+.skip:focus{left:0;top:0;background:var(--acc);color:#FFFFFF;padding:12px 16px;z-index:99;border-radius:0 0 var(--r-s) 0}
+:focus-visible{outline:3px solid var(--acc);outline-offset:3px}
+.wa-float{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:60;width:56px;height:56px;border-radius:50%;background:#2B2B2B;display:grid;place-items:center;box-shadow:0 8px 20px rgba(0,0,0,.22)}
+.wa-float svg{width:29px;height:29px;fill:#fff}
+@media print{.hdr,.ftr,.cta,.wa-float,.no-print{display:none!important}body{font-size:12pt;color:#000;background:#fff}}
